# demo: dual development simulator; live: accept ESP32 POSTs only
MODE=demo
STALE_AFTER_SECONDS=10
PERSIST_DEMO=false
DEMO_INTERVAL_SECONDS=1
DEMO_SEED=42
# Optional bearer token for ESP32 POST /api/ingest
# INGEST_TOKEN=replace-with-a-long-random-secret
# Defaults resolve relative to project root.
# DATABASE_PATH=backend/data/esu.sqlite3
# FRONTEND_DIST=frontend/dist
