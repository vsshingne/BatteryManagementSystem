# Copy to .env in the project root. Restart the backend after changing settings.
MODE=demo
SERIAL_PORT=/dev/ttyUSB0
BAUD_RATE=115200
# Decoder selection: jsonl is currently implemented. Add an adapter for other protocols.
PROTOCOL=jsonl
SERIAL_TIMEOUT=0.5
RECONNECT_SECONDS=2
STALE_AFTER_SECONDS=5
MAX_PACKET_BYTES=4096
PERSIST_DEMO=false
DEMO_INTERVAL_SECONDS=1
DEMO_SEED=42
# Defaults resolve relative to the project, independent of working directory.
# DATABASE_PATH=/home/pi/esu/backend/data/esu.sqlite3
# FRONTEND_DIST=/home/pi/esu/frontend/dist
# Optional notification thresholds: configure for YOUR battery. Disabled by default.
# VOLTAGE_HIGH=4.2
# VOLTAGE_LOW=3.0
# CURRENT_HIGH=3.0
# TEMPERATURE_HIGH=45
