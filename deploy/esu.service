[Unit]
Description=Energy Supervisory Unit telemetry gateway
After=network.target

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=dialout
WorkingDirectory=/home/pi/esu
EnvironmentFile=/home/pi/esu/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/esu/.venv/bin/python -m uvicorn app.main:app --app-dir /home/pi/esu/backend --host 0.0.0.0 --port 8000 --workers 1
Restart=on-failure
RestartSec=3
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
